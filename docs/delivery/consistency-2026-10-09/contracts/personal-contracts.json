              "operation": {
                "$ref": "#/$defs/SortOperation",
                "default": "asc"
              }
            },
            "title": "SortOrder",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "filters": {
            "items": {
              "$ref": "#/$defs/FilterCriteria"
            },
            "title": "Filters",
            "type": "array"
          },
          "page": {
            "default": 1,
