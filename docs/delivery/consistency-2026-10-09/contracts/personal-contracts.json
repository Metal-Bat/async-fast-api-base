            "title": "Size",
            "type": "integer"
          },
          "sort_orders": {
            "items": {
              "$ref": "#/$defs/SortOrder"
            },
            "title": "Sort Orders",
            "type": "array"
          }
        },
        "title": "FormQuery",
        "type": "object"
      }
    },
    "work_items": {
      "column_keys": [
        "closed_at",
        "created_at",
        "due_at",
        "kind",
        "priority",
        "status"
      ],
      "permission": "requests.start",
      "query_schema": {
        "$defs": {
          "CartableKind": {
            "enum": [
              "available",
              "claimed",
              "completed",
              "watching",
              "submitted",
              "unread"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "after": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Inclusive UTC instant lower bound.",
            "title": "After"
          },
          "before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exclusive UTC instant upper bound.",
            "title": "Before"
          },
          "cartable": {
            "$ref": "#/$defs/CartableKind"
          },
          "overdue_before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only items with a non-null deadline strictly before this instant.",
            "title": "Overdue Before"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Size",
            "type": "integer"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "OPEN",
                  "CLAIMED",
                  "IN_PROGRESS",
                  "COMPLETED",
                  "REJECTED",
                  "RETURNED",
                  "CANCELLED",
                  "EXPIRED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "time_field": {
            "default": "created_at",
            "description": "Timestamp used by optional half-open date bounds.",
            "enum": [
              "created_at",
              "closed_at"
            ],
            "title": "Time Field",
            "type": "string"
          }
        },
        "required": [
          "cartable"
        ],
        "title": "CartableQueryDTO",
        "type": "object"
      }
    },
