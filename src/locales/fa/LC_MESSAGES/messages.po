msgstr "نام قابل ویرایش کاربر یا null."

# Wave-four contracts
msgid "Valid IANA timezone for presentation; timestamps remain UTC."
msgstr "منطقه IANA معتبر برای نمایش؛ زمان‌ها به UTC می‌مانند."

# Wave-four contracts
msgid "Validate an exact handler configuration without execution"
msgstr "اعتبارسنجی پیکربندی نسخه دقیق پردازنده بدون اجرا"

# Wave-four contracts
msgid "Version of the typed personal settings contract."
msgstr "نسخه قرارداد تنظیمات شخصی تایپ‌شده."

# Wave-four contracts
msgid "Whether the field selects an exact immutable version."
msgstr "آیا فیلد نسخه تغییرناپذیر دقیق را انتخاب می‌کند."

# Wave-four contracts
msgid "Workspace control density."
msgstr "تراکم کنترل‌های فضای کار."

msgid "Authorized stable resource links and selected summaries."
msgstr "پیوندهای پایدار و مجاز منبع و خلاصه مقادیر منتخب."

msgid "Authorized chart-neutral business metric definitions and queries."
msgstr "تعریف و پرس‌وجوی شاخص‌های مجاز کسب‌وکار مستقل از کتابخانه نمودار."

msgid "Create a private saved view"
msgstr "ساخت نمای ذخیره‌شده خصوصی"

msgid "Create an authorized private favorite"
msgstr "ساخت مورد دلخواه خصوصی و مجاز"

msgid "Private authorized canonical resource favorites."
msgstr "منابع دلخواه خصوصی و مجاز با هویت پایدار."

msgid "Private versioned list presets and explicit personal defaults."
msgstr "نماهای نسخه‌دار خصوصی فهرست و پیش‌فرض‌های صریح شخصی."

msgid "Read a private saved view"
msgstr "خواندن نمای ذخیره‌شده خصوصی"

msgid "Read an authorized private favorite"
msgstr "خواندن مورد دلخواه خصوصی و مجاز"

msgid "Replace a private saved view"
msgstr "جایگزینی نمای ذخیره‌شده خصوصی"

msgid "Resolve a saved view without executing its query"
msgstr "تبدیل نمای ذخیره‌شده بدون اجرای پرس‌وجو"

msgid "Search private favorites"
msgstr "جست‌وجوی موارد دلخواه خصوصی"

msgid "Search private saved views"
msgstr "جست‌وجوی نماهای ذخیره‌شده خصوصی"

msgid "Select the personal default view"
msgstr "انتخاب نمای پیش‌فرض شخصی"

msgid ""
"Self-only favorites for the exact resource-link kind allowlist. Create accepts kind and current "
"target ref_id, authorizes through its existing owner and stores canonical UUID identity, never a "
"revision reference or target label. Repeated creation converges to one favorite; recreating an "
"explicitly removed favorite restores that personal item only. At most 100 per kind and 500 live "
"favorites per user. Search resolves current authorization and live targets before paging/count; "
"forbidden/deleted targets are omitted without titles. Version favorites remain pinned to the "
"named version. Possession grants no authority. Detail rechecks target permission; history returns"
" only safe metadata. DELETE accepts the favorite's current ref, remains available after target "
"revocation and never deletes the target. Wrong owner/missing is 404; stale delete is 409. Work-"
"item favorites continue using the existing work-item personal pin state and are not duplicated "
"here. Report aliases search; no archive generation, sharing, public URL or shared cache. Private "
"no-store envelopes."
msgstr ""
"موارد دلخواه فقط متعلق به کاربر جاری و از انواع مجاز پیوند منبع هستند. ساخت kind و ref_id جاری "
"هدف را می‌گیرد، مالک منبع مجوز را بررسی و UUID معتبر را ذخیره می‌کند، نه مرجع نسخه یا نام هدف. "
"تکرار یک مورد می‌سازد؛ بازسازی مورد حذف‌شده فقط همان حالت شخصی را برمی‌گرداند. سقف 100 مورد برای "
"هر نوع و 500 مورد زنده برای هر کاربر است. پیش از صفحه‌بندی و شمارش، مجوز جاری و زنده‌بودن هدف "
"دوباره بررسی می‌شود؛ اهداف ممنوع و حذف‌شده بدون افشای عنوان کنار می‌روند. نسخه منتخب به همان نسخه"
" ثابت می‌ماند و داشتن مرجع مجوز نمی‌دهد. جزئیات مجوز هدف را دوباره بررسی و تاریخچه فقط فراداده "
"امن را برمی‌گرداند. DELETE مرجع جاری مورد دلخواه را می‌گیرد و حتی پس از لغو مجوز هدف قابل استفاده"
" است؛ هدف را حذف نمی‌کند. مالک اشتباه یا نبودن 404 و حذف با مرجع قدیمی 409 است. مورد دلخواه کار "
"همچنان از وضعیت سنجاق موجود استفاده می‌کند و اینجا تکرار نمی‌شود. report همان جست‌وجو است؛ "
"بایگانی، اشتراک، نشانی عمومی یا کش مشترک ساخته نمی‌شود. پاسخ‌ها خصوصی و بدون کش هستند."

msgid ""
"Self-only saved list presets for forms, workflows, business_requests and work_items. Current live"
" actor and list permission are checked on every read/apply. Creation and full PUT use "
"schema_version=1, name 1–120, command_key 1–128, an at most 8 KiB validated query, up to 20 "
"filters/10 sorts, distinct allowlisted columns and page_size 1–100. Page offsets, result bodies, "
"actor/privilege fields, reference-valued filters and unknown fields are rejected. 100 live views "
"per scope; unique name per self/scope. Creation keys bind the original payload; a changed replay "
"conflicts 409. PUT is a full replacement and requires the current path ref; scope is immutable "
"and the last identical update-key replay is safe. Default selection is explicit, serializes on "
"the user and preserves exactly one default per scope. GET/search preserve an incompatible "
"original preset with compatible=false; apply then returns no query, never a broadened query. "
"Compatible apply returns page=1 and the stored size but executes no search. DELETE is idempotent "
"for the same owned item, including after permission revocation. Wrong owner/missing is non-"
"disclosing 404; stale write is 409, invalid contract is 422. History returns only safe self "
"metadata, not private filters or historical identities. Report aliases search, not an archive "
"job. Private no-store envelopes; no sharing or cache."
msgstr ""
"نماهای ذخیره‌شده فقط متعلق به کاربر جاری و برای forms، workflows، business_requests و work_items "
"هستند. کاربر زنده و مجوز فهرست در هر خواندن و اعمال بررسی می‌شود. ساخت و PUT کامل از "
"schema_version=1، نام 1 تا 120، command_key از 1 تا 128، پرس‌وجوی معتبر حداکثر 8 KiB با 20 فیلتر "
"و 10 ترتیب، ستون‌های مجاز یکتا و page_size از 1 تا 100 استفاده می‌کنند. شماره صفحه، نتیجه خام، "
"فیلد کاربر یا امتیاز، فیلتر مرجع و کلید ناشناخته رد می‌شود. هر محدوده حداکثر 100 نمای زنده با نام"
" یکتا دارد. کلید ساخت به ورودی اصلی متصل است؛ تکرار تغییرکرده 409 می‌دهد. PUT جایگزینی کامل با "
"مرجع جاری مسیر است؛ محدوده تغییر نمی‌کند و تکرار یکسان آخرین کلید به‌روزرسانی امن است. انتخاب "
"پیش‌فرض صریح با قفل کاربر فقط یک پیش‌فرض حفظ می‌کند. GET و جست‌وجو نمای ناسازگار را با "
"compatible=false حفظ می‌کنند؛ اعمال آن هیچ پرس‌وجویی نمی‌دهد و دامنه را گسترده نمی‌کند. اعمال "
"سازگار page=1 و اندازه ذخیره‌شده می‌دهد، اما جست‌وجو را اجرا نمی‌کند. حذف همان مورد خود حتی پس از"
" لغو مجوز تکرارپذیر است. مالک اشتباه یا نبودن 404، نوشتن قدیمی 409 و قرارداد نامعتبر 422 می‌دهد. "
"تاریخچه فقط فراداده امن خود است، بدون فیلتر خصوصی یا هویت تاریخی. report همان جست‌وجو است، نه کار"
" بایگانی. پاسخ خصوصی بدون کش؛ اشتراک و کش مشترک وجود ندارد."

msgid ""
"Version-one query document validated against the named list DTO. No page/size, result bodies, "
"credentials, actor identifiers or reference-valued filters. At most 8 KiB, 20 filters and 10 sort"
" orders. Cartable scopes retain only their supported typed query fields."
msgstr ""
"سند پرس‌وجوی نسخه یک با مدل فهرست مربوط اعتبارسنجی می‌شود. شماره صفحه، اندازه، بدنه نتیجه، "
"اعتبارنامه، شناسه کاربر یا فیلتر مرجع ذخیره نمی‌شود. سقف 8 KiB، 20 فیلتر و 10 ترتیب است. کارتابل "
"فقط فیلدهای تایپ‌شده پشتیبانی‌شده خود را نگه می‌دارد."

msgid "Inspect development installation readiness"
msgstr "بررسی آمادگی نصب برای نمایش توسعه"

msgid "Inspect exact definition dependencies and repair guidance"
msgstr "بررسی وابستگی‌های نسخه دقیق و راهنمای اصلاح"

msgid "Search unified notifications"
msgstr "جستجوی اعلان‌های یکپارچه"

msgid "Report unified notifications"
msgstr "گزارش صفحه‌بندی‌شده اعلان‌های یکپارچه"

msgid "Read unified unread total"
msgstr "خواندن شمار اعلان‌های خوانده‌نشده"

msgid "Read unified notification"
msgstr "خواندن اعلان یکپارچه"

msgid "Mark unified notification read"
msgstr "علامت‌گذاری اعلان به‌عنوان خوانده‌شده"

msgid "Private administrative installation readiness."
msgstr "آمادگی نصب، فقط برای مدیر کل و بدون افشای اطلاعات خصوصی."

msgid "Recipient-owned unified application notifications."
msgstr "اعلان‌های یکپارچه برنامه فقط برای گیرنده."

msgid "Opt in to optional application email; mandatory security and approval notices remain enabled."
msgstr "فعال‌سازی ایمیل اختیاری؛ اعلان ضروری امنیت و تایید همچنان فعال است."

msgid "Omitted preserves notification preferences; null resets optional email to disabled."
msgstr "حذف فیلد تنظیمات را حفظ می‌کند؛ null ایمیل اختیاری را غیرفعال می‌کند."

msgid "Notification unavailable"
msgstr "اعلان در دسترس نیست"

msgid "Request"
msgstr "درخواست"

msgid "Human task"
msgstr "کار انسانی"

msgid "Read-only approval"
msgstr "تایید فقط خواندنی"

msgid "Report"
msgstr "گزارش"

msgid "Account"
msgstr "حساب"

msgid "Resource"
msgstr "منبع"

msgid ""
"Requires a current superuser; ordinary administrators and requesters receive 403. Bounded read-"
"only database facts and internal connectivity probes return ready, blocked, unknown or "
"not_applicable. Required unknown checks prevent green overall readiness. Worker and scheduler "
"execution remain unknown until separately verified by an explicit operator command; broker "
"connectivity is insufficient. This read never installs roles, grants access, publishes "
"definitions, enqueues tasks or invokes live providers. Repair keys identify owning screens; "
"operations requires an operator. Refresh after 30 seconds and display checked_at UTC. Results "
"contain no hosts, DSNs, credentials, user lists or raw errors. Private no-store success envelope;"
" authenticated 401/403 errors use existing public codes."
msgstr ""
"فقط مدیر کل فعال اجازه دارد؛ کاربران عادی و مدیران غیرکل پاسخ 403 می‌گیرند. بررسی محدود و فقط "
"خواندنی پایگاه داده و اتصال داخلی حالت ready، blocked، unknown یا not_applicable دارد. unknown "
"ضروری مانع آمادگی کلی است. اتصال کارگزار اجرای کارگر و زمان‌بند را ثابت نمی‌کند؛ تا فرمان جداگانه"
" اپراتور وضعیت آن‌ها unknown است. این خواندن نقش نصب نمی‌کند، دسترسی نمی‌دهد، نسخه منتشر نمی‌کند،"
" کار صف نمی‌کند و ارائه‌دهنده زنده را صدا نمی‌زند. کلید اصلاح صفحه مالک را مشخص می‌کند؛ "
"operations نیازمند اپراتور است. پس از 30 ثانیه تازه‌سازی و checked_at به UTC نمایش داده شود. "
"میزبان، DSN، رمز، فهرست کاربران و خطای خام افشا نمی‌شود. پاسخ خصوصی و بدون کش در پوشش موجود است؛ "
"خطاهای 401 و 403 کدهای عمومی موجود دارند."

msgid ""
"Requires workflows.manage and ownership of the workflow, or a superuser. Validates the exact "
"current saved workflow version through the publication validator and workspace promotion policy. "
"Stale references fail 409; inaccessible versions fail 404. Returns at most 256 safe code/pointer "
"issues with selected node keys and allowlisted owning repair destinations, plus authorized exact "
"version pins. Inaccessible dependencies expose no title, reference or content. Retired pins are "
"preserved for deliberate repair; no dependency is replaced with latest. Empty candidate groups "
"are reported. Author readiness never establishes requester or service-principal eligibility. "
"Client eligibility is checked by the existing request/form publication and runtime contracts. "
"This bounded private no-store projection never writes, grants, promotes, publishes, executes a "
"handler or calls a provider. Re-read after each repair using refreshed current refs; malformed "
"bodies fail 422."
msgstr ""
"نیازمند workflows.manage و مالکیت گردش کار یا مدیر کل است. نسخه دقیق فعلی از مسیر اعتبارسنج "
"انتشار و سیاست ارتقای فضای کاری بررسی می‌شود. ارجاع قدیمی 409 و نسخه غیرمجاز 404 می‌دهد. حداکثر "
"256 خطای امن با کد، اشاره‌گر، گره منتخب و مقصد مجاز اصلاح همراه پین نسخه‌های مجاز برمی‌گردد. "
"وابستگی غیرمجاز هیچ نام، ارجاع یا محتوا افشا نمی‌کند. پین بازنشسته برای اصلاح آگاهانه حفظ می‌شود؛"
" جایگزینی با آخرین نسخه، اعطای دسترسی یا انتشار خودکار وجود ندارد. گروه بدون کاندیدا گزارش "
"می‌شود. آمادگی مولف مجوز درخواست‌کننده نیست. قابلیت رندر برای client_release_ref_id اختیاری با "
"قرارداد فرم موجود بررسی می‌شود؛ حذف یا null یعنی بررسی‌نشده. این پاسخ محدود، خصوصی و بدون کش چیزی"
" نمی‌نویسد، هندلر اجرا نمی‌کند و ارائه‌دهنده را صدا نمی‌زند. پس از اصلاح با ارجاع تازه دوباره "
"بررسی کنید؛ بدنه نامعتبر 422 می‌دهد."

msgid ""
"Authenticated recipient-only unified inbox version 1. Case, work_item, ai_approval, report and "
"account destinations resolve current owner-authorized references on every read. "
"Calendar/support/operation targets are reserved and unavailable until their producers exist. An "
"unavailable, deleted, revoked, expired or cancelled target exposes no private subject, content or"
" reference. Stored labels never confer authority. Search is bounded and deterministic with "
"existing filters/order/page/size plus unread=true/false; report is the same paginated search, not"
" a queued archive. Unread totals count live ACTIVE unread inbox rows, including redacted "
"unavailable destinations. Mark-read changes only read metadata, requires a current optimistic ref"
" (409 when stale), and never decides or acts on a workflow. Non-owned refs fail 403; "
"missing/deleted refs fail 404. Null read bodies are rejected; actions accept an empty object. UTC"
" timestamps; en/fa template locale is chosen when staged with en fallback. Private no-store "
"success/page envelopes, existing 401/403/404/409/422 errors. Refresh refs from mutation "
"responses. Optional email defaults off; mandatory notices ignore optional opt-out. No delivery is"
" performed by these reads."
msgstr ""
"صندوق یکپارچه نسخه 1 فقط برای گیرنده احرازشده است. مقصد case، work_item، ai_approval، report و "
"account در هر خواندن با مجوز مالک به ارجاع فعلی حل می‌شود. calendar، support و operation تا "
"پیاده‌سازی تولیدکننده در دسترس نیستند. مقصد حذف‌شده، لغوشده، منقضی یا سلب‌مجوزشده عنوان، محتوا یا"
" ارجاع خصوصی نشان نمی‌دهد. جستجو محدود و مرتب با filters، sort_orders، page، size و unread است؛ "
"report همان جستجوی صفحه‌بندی‌شده است، نه آرشیو صف‌شده. شمار خوانده‌نشده ردیف‌های زنده ACTIVE و "
"بدون read_at را شامل می‌شود، حتی مقصد پوشانده‌شده. علامت خواندن فقط فراداده را تغییر می‌دهد و "
"ارجاع فعلی می‌خواهد؛ هرگز عمل گردش کار انجام نمی‌دهد. ارجاع قدیمی 409، مال دیگری 403، ناموجود 404"
" و بدنه نامعتبر 422 است. فرمان {} می‌پذیرد و null رد می‌شود. زمان‌ها UTC و زبان قالب هنگام ایجاد "
"en/fa با پیش‌فرض en است. پاسخ‌ها خصوصی و بدون کش هستند. ارجاع را از پاسخ تغییر تازه کنید. ایمیل "
"اختیاری پیش‌فرض خاموش است و اعلان ضروری از خاموشی اختیاری پیروی نمی‌کند. خواندن هیچ ارسال انجام "
"نمی‌دهد."

msgid ""
"Requires workflows.manage and ownership of the workflow, or a superuser. Validates the exact "
"current saved workflow version through the publication validator and workspace promotion policy. "
"Stale references fail 409; inaccessible versions fail 404. Returns at most 256 safe code/pointer "
"issues with selected node keys and allowlisted owning repair destinations, plus authorized exact "
"version pins. Inaccessible dependencies expose no title, reference or content. Retired pins are "
"preserved for deliberate repair; no dependency is replaced with latest. Empty candidate groups "
"are reported. Author readiness never establishes requester or service-principal eligibility. An "
"optional exact client_release_ref_id checks renderer compatibility through the existing form "
"resolver; omitted/null remains not_checked. Requester eligibility still belongs to existing "
"request/runtime contracts. This bounded private no-store projection never writes, grants, "
"promotes, publishes, executes a handler or calls a provider. Re-read after each repair using "
"refreshed current refs; malformed bodies fail 422."
msgstr ""
"به مجوز workflows.manage و مالکیت یا دسترسی مدیر کل نیاز دارد. مشخصات شامل نسخه دستور و سیاست "
"بودجه است؛ نسخه منتشرشده تغییرناپذیر است. ref_id نسخه قفل خوش‌بینانه را در خود دارد."

msgid "Acknowledge a support incident"
msgstr "تأیید دریافت رخداد پشتیبانی"

msgid ""
"Authenticated Gregorian calendar. Personal events belong to their creator; a team event is "
"visible only to current active members of its explicitly selected active work group. Only the "
"creator can update/delete. No superuser bypass grants another person's calendar. Timed events use"
" aware ISO-8601 instants and an IANA timezone; storage/output are UTC. A supplied non-UTC offset "
"must match the named local wall time, rejecting DST gaps; explicit offsets disambiguate folds. "
"All-day events retain start_date/end_date, exclusive end, without conversion into timed events. "
"Each event spans at most 366 days. command_key binds exact create/update intent; same-key replay "
"returns the current result, another intent conflicts. Updates/deletes require a current revision "
"ref (409 stale); unavailable source is 404. Search/report require a half-open Gregorian date "
"range of 1–93 days and IANA timezone, size 1–100, at most 20 filters and 10 sorts. Actual live "
"work_item.due_at values appear as read-only deadline points only with requests.start and current "
"available/claimed cartable authority. Live visibility and overlap precede filtering, count, "
"ordering and pagination. Derived items link to work_items and cannot be edited as calendar "
"events. Manual links use calendar_events. History returns only transition timestamps/operations, "
"at most 1000, without private snapshots. Delete is soft and cancels pending reminders in the same"
" transaction. Up to three distinct reminder offsets of 0–2592000 seconds are supported. Existing "
"envelopes, snake_case, en/fa localization, and private no-store apply."
msgstr ""
"تقویم میلادی نیازمند احراز هویت است. رویداد شخصی متعلق به سازنده است؛ رویداد گروهی فقط برای اعضای"
" فعال جاری گروه فعال انتخاب‌شده دیده می‌شود. فقط سازنده ویرایش یا حذف می‌کند؛ مدیر کل نیز تقویم "
"دیگران را بدون این قواعد نمی‌بیند. رویداد ساعت‌دار زمان ISO-8601 دارای فاصله از UTC و منطقه IANA "
"دارد؛ ذخیره و خروجی UTC است. فاصله غیرصفر ورودی باید با زمان محلی نام‌برده یکسان باشد؛ شکاف تغییر"
" ساعت رد می‌شود و فاصله صریح ابهام ساعت تکراری را رفع می‌کند. رویداد تمام‌روز start_date/end_date"
" را با پایان خارج از بازه نگه می‌دارد و ساعت‌دار نمی‌شود. مدت هر رویداد حداکثر ۳۶۶ روز است. "
"command_key قصد دقیق ایجاد/ویرایش را تثبیت می‌کند؛ تکرار همان قصد نتیجه جاری می‌دهد و قصد متفاوت "
"تعارض دارد. ویرایش و حذف به شناسه نسخه جاری نیاز دارد؛ نسخه قدیمی 409 و منبع ناموجود 404 است. "
"بازه جست‌وجو/گزارش نیمه‌باز و ۱ تا ۹۳ روز میلادی، با منطقه IANA، size بین ۱ تا ۱۰۰، حداکثر ۲۰ "
"فیلتر و ۱۰ مرتب‌سازی است. فقط due_at واقعی کارهای فعال و مجاز با requests.start و اختیار سبد "
"available/claimed به شکل نقطه موعد فقط‌خواندنی نمایش داده می‌شود. دسترسی زنده و هم‌پوشانی قبل از "
"فیلتر، شمارش و صفحه‌بندی اعمال می‌شوند. موعد مشتق‌شده به work_items و رویداد دستی به "
"calendar_events پیوند می‌دهد؛ تقویم موعد گردش کار را ویرایش نمی‌کند. تاریخچه حداکثر ۱۰۰۰ "
"زمان/عملیات بدون داده خصوصی دارد. حذف نرم و لغو یادآوری در همان تراکنش است. حداکثر سه فاصله "
"متفاوت ۰ تا ۲۵۹۲۰۰۰ ثانیه مجاز است. قالب snake_case، پوشش استاندارد، فارسی/انگلیسی و پاسخ خصوصی "
"بدون کش برقرار است؛ تبدیل جلالی در این قرارداد پشتیبانی نمی‌شود."

msgid ""
"Authenticated safe client failure intake. Only screen_key from "
"calendar/work_items/requests/designer/reports/preferences/support, build 1–80 ASCII version "
"characters, one of client.render_failed/client.network_failed/client.unexpected_error and a UUID "
"request_id are accepted; unknown fields, text, HTML, stack and arbitrary error codes are rejected"
" 422. The actor comes from authentication. Ten new reports per actor per UTC calendar minute, "
"serialized on the user; replay among the last 100 episode correlations does not increment. Excess"
" is 429. The returned support_ref is a correlation identity, never an authorization capability. "
"persisted=false and support_ref=null explicitly report sink failure. No business operation is "
"executed. Private no-store, existing envelope and en/fa messages."
msgstr ""
"دریافت امن خطای کاربر نیازمند احراز هویت است. فقط screen_key از "
"calendar/work_items/requests/designer/reports/preferences/support، نسخه build با ۱ تا ۸۰ نویسه "
"ASCII، یکی از client.render_failed/client.network_failed/client.unexpected_error و request_id از "
"نوع UUID پذیرفته می‌شود. فیلد ناشناخته، متن، HTML، پشته و کد دلخواه با 422 رد می‌شوند؛ هویت کاربر"
" از احراز هویت می‌آید. هر کاربر در هر دقیقه تقویمی UTC حداکثر ده گزارش تازه دارد؛ هم‌زمانی روی "
"کاربر قفل می‌شود و تکرار یکی از ۱۰۰ شناسه اخیر رخداد شمارش نمی‌شود. عبور از حد 429 است. "
"support_ref فقط شناسه ارتباطی است و مجوز نیست. persisted=false همراه support_ref=null شکست "
"ذخیره‌سازی را آشکار می‌کند. هیچ عملیات کاری اجرا نمی‌شود. پاسخ خصوصی، بدون کش، با پوشش استاندارد "
"و پیام‌های فارسی/انگلیسی است."

msgid ""
"Authenticated source-owned reminder state. Manual configuration is part of event create/update; "
"work reminders require requests.start and current available/claimed cartable responsibility, a "
"current source revision ref, and an actual due_at. Configure one to three distinct offsets "
"0–2592000 seconds; command_key binds exact intent, changed intent conflicts 409. DELETE cancels "
"this actor's work reminders without changing the workflow deadline. Read exposes at most the "
"latest 100 owned reminder states, never another recipient's schedule or destination. Existing "
"database clocked one-off scheduling, durable outbox and MAP-10/11 own delivery. Event "
"edits/deletes and terminal/forwarded work changes cancel old state in the source transaction; "
"recipient authority and source revision/deadline are checked again at fire and delivery. Replays "
"cannot create duplicate notices. Late reminders deliver once within 24 hours if still relevant; "
"older occurrences expire and record bounded support lag. This never changes business state, "
"guarantees provider receipt, or creates a second timer loop. Private no-store, existing "
"snake_case envelopes and en/fa localization apply."
msgstr ""
"وضعیت یادآوری به منبع و کاربر احرازشده تعلق دارد. پیکربندی رویداد دستی همراه ایجاد/ویرایش آن است؛"
" یادآوری کار به requests.start، مسئولیت جاری available/claimed، شناسه نسخه جاری و due_at واقعی "
"نیاز دارد. یک تا سه فاصله متفاوت ۰ تا ۲۵۹۲۰۰۰ ثانیه پذیرفته می‌شود؛ command_key قصد دقیق را تثبیت"
" و تغییر قصد را با 409 رد می‌کند. DELETE فقط یادآوری‌های همین کاربر را لغو می‌کند و موعد گردش کار"
" را تغییر نمی‌دهد. خواندن حداکثر صد وضعیت اخیر متعلق به کاربر را می‌دهد، نه برنامه یا مقصد "
"دیگران. زمان‌بند clocked یک‌بارمصرف موجود، outbox پایدار و MAP-10/11 ارسال را مدیریت می‌کنند. "
"ویرایش/حذف رویداد و پایان یا ارجاع کار در همان تراکنش وضعیت قبلی را لغو می‌کند؛ مجوز گیرنده و "
"نسخه/موعد منبع هنگام اجرا و ارسال دوباره بررسی می‌شود. تکرار اعلان دیگری نمی‌سازد. یادآوری دیررس "
"فقط اگر هنوز مرتبط و حداکثر ۲۴ ساعت دیر باشد یک بار ارسال می‌شود؛ قدیمی‌تر منقضی و تأخیر در "
"پشتیبانی به‌صورت محدود ثبت می‌شود. این کار وضعیت کاری را تغییر نمی‌دهد، دریافت ارائه‌دهنده را "
"تضمین نمی‌کند و حلقه زمان‌بند دوم نمی‌سازد. پاسخ خصوصی بدون کش با قالب snake_case و پیام‌های "
"فارسی/انگلیسی است."

msgid "Correlation identity only; support.incidents.manage is still required for inspection."
msgstr "صرفاً شناسه ارتباطی؛ بررسی رخداد همچنان به مجوز support.incidents.manage نیاز دارد."

msgid "Create a calendar event"
msgstr "ایجاد رویداد تقویم"

msgid "Current authorized team reference; null creates a personal event."
msgstr "شناسه نسخه جاری گروه مجاز؛ مقدار null رویداد شخصی ایجاد می‌کند."

msgid "Exclusive Gregorian end date."
msgstr "تاریخ پایان میلادی خارج از بازه."

msgid "Exclusive aware instant after start_at, normalized to UTC."
msgstr "زمان پایان خارج از بازه و پس از start_at، همراه با منطقه زمانی و تبدیل‌شده به UTC."

msgid "IANA timezone for local presentation; canonical dates remain Gregorian."
msgstr "منطقه زمانی IANA برای نمایش محلی؛ تاریخ مرجع همیشه میلادی است."

msgid "Inclusive Gregorian date; no conversion into a timed event."
msgstr "تاریخ شروع میلادی شامل مرز؛ به رویداد ساعت‌دار تبدیل نمی‌شود."

msgid "Inclusive aware instant, normalized to UTC."
msgstr "زمان شروع شامل مرز، همراه با منطقه زمانی و تبدیل‌شده به UTC."

msgid "Personal/team Gregorian events and authorized workflow deadlines."
msgstr "رویدادهای میلادی شخصی و گروهی و موعدهای مجاز گردش کار."

msgid "Read a support incident"
msgstr "خواندن رخداد پشتیبانی"

msgid "Record a safe client failure"
msgstr "ثبت خطای امن کاربر"

msgid "Resolve a support incident"
msgstr "حل رخداد پشتیبانی"

msgid "Resolve an authorized support correlation"
msgstr "بازیابی شناسه پشتیبانی با بررسی مجوز"

msgid "Sanitized support episodes and safe client failure intake."
msgstr "رخدادهای پشتیبانی بدون داده خصوصی و دریافت امن خطای کاربر."

msgid "Search calendar events and deadlines"
msgstr "جست‌وجوی رویدادهای تقویم و موعدها"

msgid "Search support incidents"
msgstr "جست‌وجوی رخدادهای پشتیبانی"

msgid ""
"Seconds before start; up to three distinct integers from zero to thirty days. Empty disables "
"reminders."
msgstr ""
"تعداد ثانیه پیش از شروع؛ حداکثر سه عدد صحیح متفاوت از صفر تا سی روز. آرایه خالی یادآوری را "
"غیرفعال می‌کند."

msgid ""
"Support incidents require the current support.incidents.manage capability or superuser authority."
" Possession of a support_ref grants no access. Search/report apply live records and thirty-day "
"retention before count and paging (size 1–100). Safe fields contain category, numeric public "
"error code, registered operation, episode state/count and timestamps; no body, stack, prompt, "
"credential or provider message is stored or returned. Identical operation episodes coalesce for "
"one day, count is capped at 1000000 and the last 100 correlation identities deduplicate replay. A"
" resolved recurrence starts a new episode. Acknowledge requires OPEN; resolve accepts OPEN or "
"ACKNOWLEDGED. Both require the current revision ref and audit the transition. A stale or invalid "
"transition conflicts 409; outsider is 403, absent/expired is 404. History returns at most 1000 "
"safe state transitions through page/size, not diagnostic snapshots. Report aliases search. "
"Failure persistence uses an independent transaction after business rollback; a sink outage "
"returns support_persisted=false with correlation only. No recursive alert: one bounded MAP-13 "
"fanout per episode, excluding notification failures. Private no-store."
msgstr ""
"رخدادهای پشتیبانی فقط با مجوز جاری support.incidents.manage یا اختیار مدیر کل قابل بررسی هستند؛ "
"داشتن support_ref مجوز نمی‌دهد. جست‌وجو و گزارش پیش از شمارش و صفحه‌بندی، داده فعال و مهلت "
"نگهداری سی‌روزه را اعمال می‌کنند؛ size بین ۱ تا ۱۰۰ است. فیلدهای امن شامل دسته، کد عددی عمومی، "
"نام عملیات ثبت‌شده، وضعیت، تعداد و زمان‌ها هستند. بدنه، پشته، متن ارائه‌دهنده، رمز و داده فرم "
"ذخیره یا برگردانده نمی‌شود. خطاهای مشابه طی یک روز در یک رخداد جمع می‌شوند؛ تعداد تا ۱۰۰۰۰۰۰ و "
"شناسه‌های اخیر برای حذف تکرار تا ۱۰۰ محدودند. تکرار خطای حل‌شده رخداد تازه می‌سازد. acknowledge "
"فقط OPEN و resolve وضعیت OPEN یا ACKNOWLEDGED را می‌پذیرد؛ هر دو شناسه نسخه جاری و ثبت حسابرسی "
"لازم دارند. نسخه یا گذار نامعتبر 409، نبود مجوز 403 و رخداد حذف‌شده یا منقضی 404 است. تاریخچه فقط"
" حداکثر ۱۰۰۰ گذار امن وضعیت را با page/size می‌دهد؛ گزارش همان جست‌وجو است. خطا پس از بازگشت "
"تراکنش کاری در تراکنشی مستقل ثبت می‌شود. قطع ذخیره‌سازی support_persisted=false و شناسه ارتباطی "
"می‌دهد، نه ادعای ثبت قطعی. هر رخداد فقط یک ارسال گروهی محدود MAP-13 دارد و خطای اعلان دوباره "
"اعلان نمی‌سازد. پاسخ خصوصی و بدون ذخیره در کش است."

msgid "True only after independent incident commit; false means durability is unavailable."
msgstr "فقط پس از ثبت قطعی در تراکنش مستقل true است؛ false یعنی ذخیره پایدار در دسترس نیست."

msgid "UUID correlation identity; do not send stack, message or request body."
msgstr "شناسه ارتباطی UUID؛ متن خطا، پشته یا بدنه درخواست ارسال نشود."

msgid "Update a calendar event"
msgstr "ویرایش رویداد تقویم"

msgid "Preview a workflow default restoration"
msgstr "بازگردانی پیش‌فرض گردش‌کار را پیش‌نمایش کنید"

msgid "Reset draft workspace layout"
msgstr "چیدمان فضای کاری پیش‌نویس را بازنشانی کنید"

msgid ""
"Requires workflows.manage and current DRAFT/workspace revisions. Clears positions, routes, "
"collapsed nodes and viewport; preserves graph and promotion checksum. This never restores a "
"definition, discards server graph changes, publishes or resets environment data. Local unsaved-"
"edit discard belongs to the client. Private no-store."
msgstr ""
"نیازمند workflows.manage و شناسه‌های جاری پیش‌نویس و فضای کاری است. موقعیت گره‌ها، مسیرها، وضعیت "
"جمع‌شدگی و نمای صفحه را پاک می‌کند؛ گراف و چک‌سام ارتقا حفظ می‌شوند. تعریف گردش‌کار یا محیط "
"بازنشانی نمی‌شود و انتشار انجام نمی‌گیرد. دور انداختن ویرایش‌های ذخیره‌نشده بر عهدهٔ مشتری است. "
"پاسخ خصوصی no-store است."

msgid "Apply the reviewed workflow default"
msgstr "پیش‌فرض بررسی‌شدهٔ گردش‌کار را اعمال کنید"

msgid ""
"Requires live workflows.manage and current template visibility. Preview freezes the exact "
"target/workspace revisions, published template checksum and symbolic reference bindings for ten "
"minutes. An unassociated workflow requires explicit source_ref_id. Dependencies are validated "
"through existing publication rules; blockers return no plan_token. replace_draft changes only "
"DRAFT; successor creates a new DRAFT for any live target including PUBLISHED/RETIRED. Apply "
"requires the reviewed token and command_key; replay returns the same result and changed-plan key "
"reuse conflicts. Stale target/workspace, expired plan or changed dependencies conflict 409; "
"unavailable source is 404 and invalid bindings/graph are 422. Graph/workspace and the replay "
"receipt commit atomically. No automatic publication, request-type retargeting, form edit, "
"execution-pin change, secret/grant reset or provider operation occurs. Existing private no-store "
"snake_case success envelopes and en/fa localization apply."
msgstr ""
"نیازمند مجوز جاری workflows.manage و دسترسی به الگوی منتشرشده یا بازنشسته است. پیش‌نمایش، نسخهٔ "
"دقیق هدف و فضای کاری، چک‌سام الگو و نگاشت وابستگی‌ها را برای ده دقیقه تثبیت می‌کند. گردش‌کار بدون"
" سابقهٔ الگو باید source_ref_id صریح داشته باشد. وابستگی‌ها با قواعد انتشار بررسی می‌شوند؛ وجود "
"مانع یعنی plan_token صادر نمی‌شود. replace_draft فقط پیش‌نویس را تغییر می‌دهد؛ successor پیش‌نویس"
" جدیدی می‌سازد. اعمال نیازمند توکن بررسی‌شده و command_key است. تکرار همان فرمان همان نتیجه را "
"برمی‌گرداند و استفاده از کلید برای طرح دیگر تعارض دارد. نسخهٔ کهنه، انقضای طرح و تغییر وابستگی‌ها"
" خطای 409؛ منبع ناموجود خطای 404 و نگاشت یا گراف نامعتبر خطای 422 دارند. گراف، فضای کاری و رسید "
"تکرار به‌صورت اتمی ثبت می‌شوند. انتشار خودکار، تغییر مسیریابی نوع درخواست، ویرایش فرم، تغییر "
"نسخه‌های تثبیت‌شدهٔ پرونده، بازنشانی اسرار یا مجوزها و فراخوانی ارائه‌دهنده انجام نمی‌شود. پاسخ "
"خصوصی no-store با نام‌های snake_case و بومی‌سازی فارسی و انگلیسی است."

msgid ""
"Exact immutable published/retired template version; omit only when the target has recorded "
"provenance."
msgstr ""
"نسخهٔ دقیق و تغییرناپذیر الگوی منتشرشده یا بازنشسته؛ فقط در صورت وجود سابقهٔ الگو می‌توان آن را "
"حذف کرد."

msgid ""
"replace_draft replaces only the target DRAFT; successor creates a new editable version without "
"publishing."
msgstr ""
"replace_draft فقط پیش‌نویس هدف را جایگزین می‌کند؛ successor بدون انتشار، نسخهٔ قابل ویرایش جدید "
"می‌سازد."

msgid "Current independent workspace reference; null is valid only when no saved workspace exists."
msgstr "شناسهٔ جاری و مستقل فضای کاری؛ null فقط زمانی معتبر است که فضای کاری ذخیره‌شده وجود نداشته باشد."

msgid ""
"At most 128 exact dependency replacements. Keys are kind:step_key, or "
"user/work_group:step_key:target_index. Supported kinds: form, step_type, user, work_group, "
"connection, agent, subprocess. Omitted bindings retain the associated installation mapping when "
"source_ref_id is omitted."
msgstr ""
"حداکثر ۱۲۸ جایگزینی دقیق وابستگی. کلیدها kind:step_key یا user/work_group:step_key:target_index "
"هستند. نوع‌های مجاز form، step_type، user، work_group، connection، agent و subprocess هستند. با "
"حذف source_ref_id نگاشت ثبت‌شدهٔ نصب حفظ می‌شود."

msgid "Safe changed top-level definition paths; no embedded config or private values."
msgstr "مسیرهای سطح بالای تغییرکردهٔ تعریف بدون پیکربندی یا مقادیر خصوصی."

msgid ""
"Client-generated restore intent identity. Reuse with the identical reviewed token to replay; a "
"different token conflicts."
msgstr ""
"شناسهٔ قصد بازگردانی که مشتری تولید می‌کند. تکرار با همان توکن بررسی‌شده همان نتیجه را "
"برمی‌گرداند؛ توکن متفاوت تعارض دارد."

msgid ""
"Opaque signed preview token. New application expires after 600 seconds; a committed command can "
"replay after expiry subject to current authorization."
msgstr ""
"توکن امضاشدهٔ پیش‌نمایش. اعمال جدید پس از ۶۰۰ ثانیه منقضی است؛ فرمان ثبت‌شده با مجوز جاری پس از "
"انقضا قابل تکرار است."

#~ msgid "Authentication and user account operations."
#~ msgstr "عملیات حساب‌های کاربری."
